generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnidadeMedida {
  KG
  GRAMA
  PECA
  FATIA
}

enum StatusPedido {
  REGISTRADO
  EM_PREPARO
  CONCLUIDO
}

enum StatusSenha {
  PENDENTE
  CHAMADA
  FINALIZADA
  EXPIRADA
}

model Corte {
  id           String       @id @default(uuid()) @db.Uuid
  nome         String
  imagemUrl    String
  precoKg      Decimal      @db.Decimal(12, 2)
  disponivel   Boolean      @default(true)
  dataCadastro DateTime     @default(now())
  itensPedido  ItemPedido[]
}

model SessaoTotem {
  id               String    @id @db.Uuid
  dataInicio       DateTime  @default(now())
  dataFim          DateTime?
  pedidoConfirmado Boolean   @default(false)
  pedido           Pedido?
}

model Pedido {
  id            String            @id @default(uuid()) @db.Uuid
  numeroPedido  Int               @unique @default(autoincrement())
  sessaoId      String            @unique @db.Uuid
  status        StatusPedido      @default(REGISTRADO)
  presencial    Boolean           @default(true)
  total         Decimal           @db.Decimal(12, 2)
  dataCriacao   DateTime          @default(now())
  dataConclusao DateTime?
  sessao        SessaoTotem       @relation(fields: [sessaoId], references: [id], onDelete: Restrict)
  itensPedido   ItemPedido[]
  senha         SenhaAtendimento?

  @@index([dataCriacao])
}

model ItemPedido {
  id              String        @id @default(uuid()) @db.Uuid
  pedidoId        String        @db.Uuid
  corteId         String        @db.Uuid
  quantidade      Decimal       @db.Decimal(12, 3)
  unidadeMedida   UnidadeMedida
  presencial      Boolean       @default(true)
  precoUnitarioKg Decimal       @db.Decimal(12, 2)
  subtotal        Decimal       @db.Decimal(12, 2)
  pedido          Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  corte           Corte         @relation(fields: [corteId], references: [id], onDelete: Restrict)
}

model SenhaAtendimento {
  id                 String         @id @default(uuid()) @db.Uuid
  numeroSequencial   Int            @unique @default(autoincrement())
  pedidoId           String         @unique @db.Uuid
  status             StatusSenha    @default(PENDENTE)
  quantidadeChamadas Int            @default(0)
  numeroReemissoes   Int            @default(0)
  ultimaChamada      DateTime?
  dataGeracao        DateTime       @default(now())
  reservaSenhaId     String?        @db.Uuid
  pedido             Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  reservaSenha       ReservaSenha?  @relation(fields: [reservaSenhaId], references: [id], onDelete: Restrict)
  chamadas           ChamadaSenha[]
}

model ReservaSenha {
  id           String             @id @db.Uuid
  totemId      String             @db.Uuid
  numeroInicio Int
  numeroFim    Int
  catalogo     Json
  dataReserva  DateTime           @default(now())
  senhas       SenhaAtendimento[]

  @@index([totemId, numeroInicio])
}

model ChamadaSenha {
  id          String           @id @default(uuid()) @db.Uuid
  senhaId     String           @db.Uuid
  dataChamada DateTime         @default(now())
  reemissao   Boolean          @default(false)
  senha       SenhaAtendimento @relation(fields: [senhaId], references: [id], onDelete: Cascade)

  @@index([dataChamada])
}
